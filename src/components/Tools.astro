---
import tools from '../data/tools.json';
const set = Array(4).fill(tools).flat();
---
<section class="tools" aria-label="Tools I use">
  <p class="tools-label">Tools I use</p>
  <div class="marquee"><div class="track">
    {[0, 1].map(() => (
      <ul>{set.map((t) => <li>{t.logo ? <img src={t.logo} alt={t.name} /> : <span>{t.name}</span>}</li>)}</ul>
    ))}
  </div></div>
</section>
