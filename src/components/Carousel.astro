---
const { images = [], interval = 4000 } = Astro.props;
---
{images.length === 0 ? <div class="ph" /> : (
  <div class="cwrap">
    <div class="carousel" data-carousel data-interval={interval}>
      {images.map((src) => <img src={src} alt="" loading="lazy" />)}
    </div>
    {images.length > 1 && <div class="dots">{images.map(() => <i />)}</div>}
  </div>
)}
<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((el) => {
    const n = el.children.length;
    if (n < 2) return;
    const dots = el.parentElement?.querySelectorAll('.dots i');
    const sync = () => {
      const i = Math.round(el.scrollLeft / (el.clientWidth || 1));
      dots?.forEach((d, k) => d.classList.toggle('on', k === i));
    };
    el.addEventListener('scroll', sync, { passive: true });
    sync();
    const interval = Number(el.dataset.interval) || 4000;
    let paused = false;
    ['mouseenter', 'touchstart', 'focusin'].forEach((e) => el.addEventListener(e, () => (paused = true), { passive: true }));
    ['mouseleave', 'touchend', 'focusout'].forEach((e) => el.addEventListener(e, () => (paused = false), { passive: true }));
    setInterval(() => {
      if (paused || !el.clientWidth) return;
      const w = el.clientWidth;
      const i = Math.round(el.scrollLeft / w);
      el.scrollTo({ left: ((i + 1) % n) * w, behavior: 'smooth' });
    }, interval);
  });
</script>
