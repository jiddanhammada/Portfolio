---
import site from '../data/site.json';
const svg = (inner) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${inner}</svg>`;
const icons = {
  linkedin: svg('<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>'),
  instagram: svg('<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>'),
  threads: svg('<circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"/>'),
  whatsapp: svg('<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>'),
};
const main = [['Home', '/'], ['Projects', '/projects'], ['Activity', '/activity'], ['About me', '/about']];
const more = [['Experience', '/#experience'], ['Achievements', '/#achievements'], ['Contact', '/contact']];
---
<footer class="foot">
  <div class="wrap foot-in">
    <div class="foot-left">
      <h3>{site.footerHeading}</h3>
      <p>{site.footerText}</p>
      <div class="socials">
        {site.social.map((s) => <a href={s.href || undefined} aria-label={s.name} target="_blank" rel="noopener"><Fragment set:html={icons[s.icon]} /></a>)}
      </div>
      <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    <nav class="foot-links">
      <div><span>Main</span>{main.map(([l, h]) => <a href={h}>{l}</a>)}</div>
      <div><span>More</span>{more.map(([l, h]) => <a href={h}>{l}</a>)}</div>
    </nav>
  </div>
  <div class="foot-mark" aria-hidden="true">{site.name}</div>
</footer>
