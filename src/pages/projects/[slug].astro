---
import Layout from '../../layouts/Layout.astro';
import site from '../../data/site.json';
import defaults from '../../data/case-studies.json';
import ProjectVisual from '../../components/ProjectVisual.astro';
import ProjectTile from '../../components/ProjectTile.astro';
import RichText from '../../components/RichText.astro';
import { getProjects } from '../../lib/sanity.js';

export async function getStaticPaths() {
  const projects = (await getProjects()).filter((p) => p.slug);
  return projects.map((p, i) => {
    const others = projects.map((x, j) => ({ ...x, _n: j + 1 })).filter((x) => x.slug !== p.slug);
    const related = [...others.filter((x) => x.type === p.type), ...others.filter((x) => x.type !== p.type)].slice(0, 3);
    return { params: { slug: p.slug }, props: { p, prev: projects[i - 1] ?? null, next: projects[i + 1] ?? null, index: i, related } };
  });
}
const { p, prev, next, index, related } = Astro.props;

// Case-study content: starter text from src/data/case-studies.json, overridden field by field by whatever is filled in Sanity.
const has = (v) => (Array.isArray(v) ? v.length > 0 : v !== null && v !== undefined && String(v).trim() !== '');
const cs = { ...(defaults[p.slug] || {}) };
for (const k of Object.keys(p)) if (has(p[k])) cs[k] = p[k];

const year = new Date(p.date).getFullYear();
const pad = (n) => String(n).padStart(2, '0');
const src = (u, w) => `${u}?w=${w}&auto=format`;
const srcset = (u, ws) => ws.map((w) => `${src(u, w)} ${w}w`).join(', ');
const paras = (t) => String(t || '').split(/\n\s*\n/).map((x) => x.trim()).filter(Boolean);
const hasDash = (t) => /(^|\n)\s*[-–•]\s+|[.:;!?]\s+[-–•]\s+\S/.test(String(t || ''));
const bullets = (t) => paras(t).flatMap((x) => x.split(/(?<=[.!?])\s+(?=[A-Z])/)).map((s) => s.trim()).filter(Boolean);
const segs = (t) => String(t).split('**');
const KIND = { measured: 'Measured result', expected: 'Expected benefit', qualitative: 'Finding', deliverable: 'Deliverable' };
const status = p.status === 'ongoing' ? 'Ongoing' : 'Completed';

const meta = [
  ['Project type', cs.projectType],
  ['My role', cs.roleShort],
  ['Duration', p.period || String(year)],
  ['Team', cs.team],
].filter(([, v]) => has(v));

// "details" is the older summary field: shown only when no overview or role exists
const summary = (() => {
  if (!p.details || has(cs.overview) || has(cs.role)) return null;
  const [head, ...rest] = p.details.split(/\n\s*\n/);
  return { lines: head.split('\n').map((s) => s.trim()).filter(Boolean), bullets: rest.join('\n').split('\n').map((s) => s.replace(/^[•-]\s*/, '').trim()).filter(Boolean) };
})();

const hasOverview = has(cs.overview) || has(cs.background) || has(cs.problem) || has(cs.problemPoints) || has(cs.objectives) || has(cs.successCriteria) || !!summary;
const hasResults = has(cs.results) || has(cs.outcome) || has(cs.outcomeImage);
const hasReflection = has(cs.reflection) || has(cs.limitations) || has(cs.nextSteps) || has(cs.skills);
const timeline = cs.timeline || [];
const process = cs.process || [];
const results = cs.results || [];
// the strongest measured result gets the large card
const lead = results.findIndex((r) => has(r.value) && (r.kind || 'measured') === 'measured');
const raw = p.rawImages || [];

// gallery layout: wide first image, then unequal pairs; every photo keeps its own proportions
const dims = p.imageDims || [];
const caps = p.imageCaptions || [];
const gallery = (() => {
  const items = raw.map((u, i) => ({ u, i, cap: caps[i] || '', portrait: dims[i] && dims[i].height > dims[i].width * 1.05 })).filter((x) => x.i > 0);
  const out = []; let i = 0, k = 0;
  while (i < items.length) {
    const left = items.length - i;
    let widths = k === 0 || left === 1 ? [12] : k % 2 === 1 ? [7, 5] : [5, 7];
    const row = items.slice(i, i + widths.length);
    if (row.length === 2 && row[0].portrait !== row[1].portrait) widths = row[0].portrait ? [5, 7] : [7, 5];
    const w = row.length === widths.length ? widths : [12];
    row.forEach((it, j) => out.push({ ...it, span: w[j] }));
    i += row.length; k++;
  }
  return out;
})();

const toc = [
  ['overview', 'Overview', hasOverview],
  ['contributions', 'My contributions', has(cs.role)],
  ['process', 'Process and timeline', process.length > 0 || timeline.length > 0],
  ['results', 'Results and impact', hasResults],
  ['reflection', 'Reflection', hasReflection],
  ['gallery', 'Gallery', gallery.length > 0],
].filter((t) => t[2]);
---
<Layout title={`${p.title} · ${site.name}`}>
  <article class="case" data-case>

    <header class="cs-hero rv">
      <a class="cs-back" href="/projects">← Selected projects</a>
      <p class="cs-kick"><span class="chip"><i class="dot"></i>{p.type}</span><span>{status}</span></p>
      <h1>{p.title}</h1>
      <p class="cs-lead">{p.caption}</p>
      {meta.length > 0 && <dl class="cs-meta">{meta.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>}
      {has(p.tags) && <ul class="cs-chips" aria-label="Tools and technologies">{p.tags.map((t) => <li>{t}</li>)}</ul>}
      {p.links && p.links.length > 0 && <p class="cs-links">{p.links.map((l) => <a class="pill invert" href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>)}</p>}
      <figure class="cs-hero-img">
        <ProjectVisual p={p} n={pad(index + 1)} sizes="100vw" eager={true} />
      </figure>
    </header>

    <div class="cs-layout">
      <nav class="cs-toc" data-toc aria-label="On this page">
        <ol>{toc.map(([id, label], i) => <li><a href={`#${id}`} class={i === 0 ? 'on' : ''}>{label}</a></li>)}</ol>
      </nav>

      <div class="cs-main">

        {hasOverview && (
          <section class="cs-sec rv" id="overview" aria-labelledby="h-overview">
            <h2 id="h-overview">Overview</h2>
            {has(cs.overview) && <div class="cs-text cs-intro"><RichText text={cs.overview} /></div>}
            {summary && (
              <div class="cs-intro">
                {summary.lines.map((l) => <p class="cs-ctx">{l}</p>)}
                {summary.bullets.length > 0 && <ul class="cs-list">{summary.bullets.map((b) => <li>{b}</li>)}</ul>}
              </div>
            )}
            <div class="cs-cols">
              {has(cs.background) && <div><h3>Background</h3><div class="cs-text"><RichText text={cs.background} /></div></div>}
              {(has(cs.problem) || has(cs.problemPoints)) && (
                <div>
                  <h3>Challenge</h3>
                  {has(cs.problem) && <div class="cs-text"><RichText text={cs.problem} /></div>}
                  {has(cs.problemPoints) && <ul class="cs-list">{cs.problemPoints.map((b) => <li>{b}</li>)}</ul>}
                </div>
              )}
              {(has(cs.objectives) || has(cs.successCriteria)) && (
                <div>
                  {has(cs.objectives) && (<><h3>Objectives</h3><ul class="cs-list">{cs.objectives.map((o) => <li>{o}</li>)}</ul></>)}
                  {has(cs.successCriteria) && (<><h3 class="gap">Success criteria</h3><ul class="cs-list">{cs.successCriteria.map((o) => <li>{o}</li>)}</ul></>)}
                </div>
              )}
            </div>
          </section>
        )}

        {has(cs.role) && (
          <section class="cs-sec rv" id="contributions" aria-labelledby="h-contributions">
            <h2 id="h-contributions">My contributions</h2>
            {hasDash(cs.role) ? <div class="cs-text"><RichText text={cs.role} /></div> : <ul class="cs-list">{bullets(cs.role).map((b) => <li>{b}</li>)}</ul>}
          </section>
        )}

        {(process.length > 0 || timeline.length > 0) && (
          <section class="cs-sec rv" id="process" aria-labelledby="h-process">
            <h2 id="h-process">Process and timeline</h2>
            {process.length > 0 && (
              <>
                {timeline.length > 0 && <h3>Approach</h3>}
                <ol class={`cs-flow${process.length > 6 ? ' vertical' : ''}`}>
                  {process.map((s, i) => (
                    <li>
                      <span class="cs-flow-n">Step {i + 1}</span>
                      <h3>{s.title}</h3>
                      {s.text && <div class="cs-rtext"><RichText text={s.text} /></div>}
                      {s.image && <img src={src(s.image, 900)} srcset={srcset(s.image, [500, 900, 1400])} sizes="(min-width: 900px) 30vw, 90vw" alt={`${s.title}: visual evidence`} loading="lazy" decoding="async" />}
                    </li>
                  ))}
                </ol>
              </>
            )}
            {timeline.length > 0 && (
              <>
                {process.length > 0 && <h3 class="gap">Milestones</h3>}
                <ol class={`cs-flow cs-time${timeline.length > 5 ? ' vertical' : ''}`}>
                  {timeline.map((t) => (
                    <li>
                      <span class="cs-flow-n">{t.when}</span>
                      <h3>{t.title}</h3>
                      {t.text && <div class="cs-rtext"><RichText text={t.text} /></div>}
                      {t.deliverable && <p class="cs-deliv"><b>Deliverable</b>{t.deliverable}</p>}
                    </li>
                  ))}
                </ol>
              </>
            )}
          </section>
        )}

        {hasResults && (
          <section class="cs-sec rv" id="results" aria-labelledby="h-results">
            <h2 id="h-results">Results and impact</h2>
            {has(cs.outcome) && <div class="cs-text"><RichText text={cs.outcome} /></div>}
            {results.length > 0 && (
              <ul class="cs-results">
                {results.map((r, i) => (
                  <li class={`${has(r.value) ? '' : 'finding'}${i === lead ? ' lead' : ''}`.trim()}>
                    <span class="cs-kind"><i class="dot"></i>{KIND[r.kind] || KIND.measured}</span>
                    {has(r.value) && <b>{r.value}</b>}
                    <span class="cs-res-label">{r.label}</span>
                    {r.text && <div class="cs-rtext"><RichText text={r.text} /></div>}
                  </li>
                ))}
              </ul>
            )}
            {cs.outcomeImage && (
              <figure class="cs-evidence">
                <img src={src(cs.outcomeImage, 1400)} srcset={srcset(cs.outcomeImage, [800, 1400, 2000])} sizes="(min-width: 900px) 70vw, 100vw" alt={cs.outcomeCaption || `${p.title}: result`} loading="lazy" decoding="async" />
                {cs.outcomeCaption && <figcaption>{cs.outcomeCaption}</figcaption>}
              </figure>
            )}
          </section>
        )}

        {hasReflection && (
          <section class="cs-sec rv" id="reflection" aria-labelledby="h-reflection">
            <h2 id="h-reflection">Reflection</h2>
            {has(cs.reflection) && <div class="cs-text"><RichText text={cs.reflection} /></div>}
            {(has(cs.limitations) || has(cs.nextSteps)) && (
              <div class="cs-two cs-after">
                {has(cs.limitations) && <div><h3>Limitations</h3><div class="cs-text"><RichText text={cs.limitations} /></div></div>}
                {has(cs.nextSteps) && <div><h3>Potential improvements</h3><div class="cs-text"><RichText text={cs.nextSteps} /></div></div>}
              </div>
            )}
            {has(cs.skills) && <div class="cs-after"><h3>Skills developed</h3><ul class="cs-chips">{cs.skills.map((s) => <li>{s}</li>)}</ul></div>}
          </section>
        )}

        {gallery.length > 0 && (
          <section class="cs-sec rv" id="gallery" aria-labelledby="h-gallery">
            <h2 id="h-gallery">Project gallery</h2>
            <div class="cs-gallery">
              {gallery.map((g) => (
                <figure class={`cs-fig s${g.span}${g.portrait ? ' portrait' : ''}`}>
                  <button type="button" data-full={src(g.u, 2000)} data-alt={g.cap || `${p.title}, image ${g.i + 1} of ${raw.length}`} aria-label={`Open image ${g.i + 1} of ${raw.length}`}>
                    <img src={src(g.u, 1100)} srcset={srcset(g.u, [500, 1100, 1700])} sizes={`(min-width: 900px) ${Math.round(g.span / 12 * 70)}vw, 100vw`} alt={g.cap || `${p.title}, image ${g.i + 1}`} loading="lazy" decoding="async" />
                  </button>
                  {g.cap && <figcaption>{g.cap}</figcaption>}
                </figure>
              ))}
            </div>
          </section>
        )}

      </div>
    </div>

    <footer class="cs-more rv">
      {(prev || next) && (
        <nav class="cs-pnbar" aria-label="Previous and next project">
          {prev ? <a href={`/projects/${prev.slug}`} rel="prev"><small>← Previous project</small><b>{prev.title}</b></a> : <span></span>}
          {next ? <a class="next" href={`/projects/${next.slug}`} rel="next"><small>Next project →</small><b>{next.title}</b></a> : <span></span>}
        </nav>
      )}
      {related.length > 0 && (
        <section aria-labelledby="h-related">
          <h2 id="h-related">Related projects</h2>
          <div class="cs-rel">{related.map((r) => <ProjectTile p={r} n={r._n} variant="narrow" />)}</div>
        </section>
      )}
      <div class="a-actions">
        <a class="pill invert" href="/projects">Back to selected projects</a>
        <a class="pill" href="/contact">Contact me</a>
      </div>
    </footer>

  </article>

  <dialog class="lb" data-lb aria-label="Image viewer">
    <button class="lb-close" type="button" aria-label="Close">✕</button>
    <button class="lb-prev" type="button" aria-label="Previous image">←</button>
    <img alt="" />
    <button class="lb-next" type="button" aria-label="Next image">→</button>
    <p class="lb-count" aria-live="polite"></p>
  </dialog>
</Layout>
<script>
  const root = document.querySelector<HTMLElement>('[data-case]');
  if (root) {
    // gallery lightbox
    const dlg = document.querySelector<HTMLDialogElement>('[data-lb]');
    const thumbs = [...root.querySelectorAll<HTMLElement>('[data-full]')];
    if (dlg && thumbs.length) {
      const img = dlg.querySelector('img')!;
      const count = dlg.querySelector('.lb-count')!;
      let i = 0;
      const show = (k: number) => {
        i = (k + thumbs.length) % thumbs.length;
        img.src = thumbs[i].dataset.full!;
        img.alt = thumbs[i].dataset.alt || '';
        count.textContent = `${i + 1} / ${thumbs.length}`;
      };
      thumbs.forEach((t, k) => t.addEventListener('click', () => { show(k); dlg.showModal(); }));
      dlg.querySelector('.lb-prev')!.addEventListener('click', () => show(i - 1));
      dlg.querySelector('.lb-next')!.addEventListener('click', () => show(i + 1));
      dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
      dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(i - 1); if (e.key === 'ArrowRight') show(i + 1); });
    }

    // table of contents: highlight the section being read
    const links = [...root.querySelectorAll<HTMLAnchorElement>('[data-toc] a')];
    const bar = matchMedia('(max-width: 900px)');
    const mark = (id: string) => links.forEach((a) => {
      const on = a.getAttribute('href') === '#' + id;
      a.classList.toggle('on', on);
      if (on && bar.matches) a.scrollIntoView?.({ inline: 'center', block: 'nearest' });
    });
    if ('IntersectionObserver' in window) {
      const spy = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) mark(e.target.id); }), { rootMargin: '-15% 0px -70% 0px' });
      links.forEach((a) => { const s = document.getElementById(a.getAttribute('href')!.slice(1)); if (s) spy.observe(s); });
    }

    // fade in on scroll
    if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.classList.add('rv-ready');
      const io = new IntersectionObserver((entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }), { threshold: 0.06, rootMargin: '0px 0px -6% 0px' });
      root.querySelectorAll('.rv').forEach((el) => io.observe(el));
    }
  }
</script>
